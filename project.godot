; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Beat the bully"
config/description="Beat the Bully es un RPG rítmico 2D ambientado en una High School de los años 90, donde la música es la única arma contra el bullying."
config/version="0.1.5"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://dprwo8fknd0t2"
config/icon="uid://s0m5p3ac685k"

[audio]

buses/default_bus_layout="res://resources/data/default_bus_layout.tres"

[autoload]

Gamemanager="*uid://uh4t4v30gsf5"
QuestManager="*res://scripts/quests/quest_manager.gd"
ColorblindOverlay="*res://scenes/ui/colorblind_overlay.tscn"
SaveManager="*res://scripts/save/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/cinematic_authoring/plugin.cfg")

