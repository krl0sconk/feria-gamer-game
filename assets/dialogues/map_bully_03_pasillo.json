{
  "version": 1,
  "dialogues": {
    "intro": {
      "lines": [
        { "speaker": "Bully", "text": "Por aquí no pasas." },
        { "speaker": "Hermano", "text": "Sin ganar, no." },
        { "speaker": "Jugador", "text": "Entonces voy a ganar." }
      ]
    },
    "victory": {
      "lines": [
        { "speaker": "Bully", "text": "Pasó el ritmo. Pasa él también." },
        { "speaker": "Jugador", "text": "Gracias." }
      ]
    },
    "defeat": {
      "lines": [
        { "speaker": "Bully", "text": "Inténtalo de nuevo cuando estés listo." },
        { "speaker": "Jugador", "text": "Voy a estarlo." }
      ]
    },
    "defeated": {
      "lines": [
        { "speaker": "Bully", "text": "Ya te abrimos paso. No empujes." },
        { "speaker": "Jugador", "text": "No iba a." }
      ]
    }
  }
}
