{
  "version": 1,
  "dialogues": {
    "intro": {
      "lines": [
        { "speaker": "Compañera", "text": "Oye. Hay alguien que anda haciendo daño por mensajes. Nadie lo enfrenta." },
        { "speaker": "Jugador", "text": "¿Sabes dónde está?" },
        { "speaker": "Compañera", "text": "Sí. Ven, te llevo." }
      ]
    },
    "win": {
      "lines": [
        { "speaker": "Compañera", "text": "Lo encontramos. Ahora tú." },
        { "speaker": "Jugador", "text": "Voy." }
      ]
    },
    "defeated": {
      "lines": [
        { "speaker": "Compañera", "text": "Ya está. Gracias por ayudar." },
        { "speaker": "Jugador", "text": "Era lo que había que hacer." }
      ]
    }
  }
}
