{
  "version": 1,
  "dialogues": {
    "intro": {
      "lines": [
        { "speaker": "Hermano", "text": "Mi hermano no gana solo. Yo tampoco." },
        { "speaker": "Jugador", "text": "Dos contra el ritmo. Bien." }
      ]
    },
    "victory": {
      "lines": [
        { "speaker": "Hermano", "text": "Ni mal. Dos nulos." },
        { "speaker": "Jugador", "text": "Empate de respeto." }
      ]
    },
    "defeat": {
      "lines": [
        { "speaker": "Hermano", "text": "Hoy no. Mañana si quieres." },
        { "speaker": "Jugador", "text": "Mañana entonces." }
      ]
    },
    "defeated": {
      "lines": [
        { "speaker": "Hermano", "text": "No te guardo rencor." },
        { "speaker": "Jugador", "text": "Bien." }
      ]
    }
  }
}
