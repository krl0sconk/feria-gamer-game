{
  "version": 1,
  "dialogues": {
    "intro": {
      "lines": [
        { "speaker": "Bully", "text": "Mira quien se cree heroe del salon." },
        { "speaker": "Jugador", "text": "No soy heroe. Solo no me quedo callado." },
        { "speaker": "Bully", "text": "Entonces demuestralo con ritmo." }
      ]
    },
    "victory": {
      "lines": [
        { "speaker": "Bully", "text": "Ok... me ganaste limpio." },
        { "speaker": "Jugador", "text": "No necesito humillarte para frenarte." },
        { "speaker": "Bully", "text": "Entendi. Lo voy a pensar." }
      ]
    },
    "defeat": {
      "lines": [
        { "speaker": "Bully", "text": "Mucho discurso, poco ritmo." },
        { "speaker": "Jugador", "text": "No termina aqui. Voy a volver." }
      ]
    }
  }
}
