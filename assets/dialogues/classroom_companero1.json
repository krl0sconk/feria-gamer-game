{
	"version": 1,
	"dialogues": {
		"intro": {
			"lines": [
				{ "speaker": "Daniel", "text": "Me tienen de punto en el salón. No sé qué hacer." },
				{ "speaker": "Jugador", "text": "No estás solo. Cuéntame." },
				{ "speaker": "Daniel", "text": "...Gracias. Con eso ya me ayudas." }
			]
		},
		"win": {
			"lines": [
				{ "speaker": "Daniel", "text": "Nadie había hecho eso antes." },
				{ "speaker": "Jugador", "text": "Alguien tenía que." },
				{ "speaker": "Daniel", "text": "No tenías que. Elegiste hacerlo. Eso es diferente." },
				{ "speaker": "Daniel", "text": "Soy Daniel." }
			]
		}
	}
}
